# The entire site requires authentication: an admin-approved email signs in
# via a one-time emailed link, then must complete Duo MFA. All values below
# are required - the server refuses to start without them (fail closed).

# PORT: optional. Defaults to 3000 locally; most hosts (Render, Railway,
# Fly, etc.) inject this automatically.
PORT=3000

# APP_BASE_URL: the public HTTPS URL this app is served from. Used to build
# the emailed sign-in link and the Duo OIDC redirect URL.
APP_BASE_URL="https://verbanovae.com"

# ADMIN_EMAIL: the one email address allowed to access /admin (approve or
# revoke other users). Does not need to be separately added to
# approved_emails - it always has access.
ADMIN_EMAIL="you@example.com"

# SESSION_SECRET: random secret used to sign the short-lived pre-Duo cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="MY_SESSION_SECRET"

# DATABASE_URL: Postgres connection string (e.g. from Neon). Holds approved
# emails, registered users, login tokens, and sessions.
DATABASE_URL="postgres://user:password@host/dbname"

# RESEND_API_KEY: sends the one-time sign-in link emails.
RESEND_API_KEY="MY_RESEND_API_KEY"
# RESEND_FROM_EMAIL: optional. Defaults to Resend's shared test-sending
# domain; set this once you've verified your own domain in Resend, e.g.
# RESEND_FROM_EMAIL="Mancala Solver <login@verbanovae.com>"
RESEND_FROM_EMAIL=""

# Duo (MFA), from the Duo Admin Panel's Web SDK application:
DUO_CLIENT_ID="MY_DUO_CLIENT_ID"
DUO_CLIENT_SECRET="MY_DUO_CLIENT_SECRET"
DUO_API_HOST="api-xxxxxxxx.duosecurity.com"
